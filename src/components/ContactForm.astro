---
import { site } from "../data/site.js";
---

<form
	action="https://api.web3forms.com/submit"
	method="POST"
	class="space-y-4 rounded-2xl bg-stone-50 p-8"
>
	<input type="hidden" name="access_key" value="4ee18771-c6ee-4e7d-8d6a-7bdf2a5daa7b" />
	<input type="hidden" name="subject" value={`Ny besked fra ${site.business.name}`} />
	<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

	<div>
		<label for="name" class="block text-sm font-medium text-stone-700">Navn</label>
		<input
			type="text"
			id="name"
			name="name"
			required
			class="mt-1 w-full rounded-lg border border-stone-300 px-4 py-2.5 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
		/>
	</div>

	<div>
		<label for="email" class="block text-sm font-medium text-stone-700">Email</label>
		<input
			type="email"
			id="email"
			name="email"
			required
			class="mt-1 w-full rounded-lg border border-stone-300 px-4 py-2.5 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
		/>
	</div>

	<div>
		<label for="message" class="block text-sm font-medium text-stone-700">Besked</label>
		<textarea
			id="message"
			name="message"
			rows="5"
			required
			class="mt-1 w-full rounded-lg border border-stone-300 px-4 py-2.5 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
		></textarea>
	</div>

	<button
		type="submit"
		class="w-full rounded-full bg-primary px-6 py-3 font-medium text-white transition-colors hover:bg-primary/90"
	>
		Send besked
	</button>
</form>
