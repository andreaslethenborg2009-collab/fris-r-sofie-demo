---
import { site } from "../data/site.js";
import ContactForm from "./ContactForm.astro";

const { address, phone, email, openingHours } = site.business;
const mapQuery = encodeURIComponent(`${address.street}, ${address.postalCode} ${address.city}`);
---

<section id="kontakt" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="font-heading text-3xl font-bold text-stone-900 md:text-4xl">Book en tid</h2>
		<p class="mt-4 text-stone-600">Skriv til os, ring, eller kig forbi — vi glæder os til at se dig.</p>
	</div>

	<div class="mt-14 grid gap-10 md:grid-cols-2">
		<div class="space-y-8">
			<div class="grid gap-6 sm:grid-cols-2">
				<div>
					<h3 class="font-heading font-semibold text-stone-900">Adresse</h3>
					<p class="mt-2 text-stone-600">
						{address.street}<br />
						{address.postalCode} {address.city}
					</p>
				</div>
				<div>
					<h3 class="font-heading font-semibold text-stone-900">Kontakt</h3>
					<p class="mt-2 text-stone-600">
						<a href={`tel:${phone.replace(/\s/g, "")}`} class="hover:text-primary">{phone}</a><br />
						<a href={`mailto:${email}`} class="hover:text-primary">{email}</a>
					</p>
				</div>
			</div>

			<div>
				<h3 class="font-heading font-semibold text-stone-900">Åbningstider</h3>
				<ul class="mt-2 space-y-1 text-stone-600">
					{openingHours.map((entry) => (
						<li class="flex justify-between gap-4 sm:max-w-xs">
							<span>{entry.days}</span>
							<span>{entry.hours}</span>
						</li>
					))}
				</ul>
			</div>

			<iframe
				title="Kort over salonens placering"
				src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
				class="h-64 w-full rounded-2xl border-0"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>

		<ContactForm />
	</div>
</section>
