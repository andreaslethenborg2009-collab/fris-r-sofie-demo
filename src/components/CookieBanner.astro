<div
	id="cookie-banner"
	class="fixed inset-x-0 bottom-0 z-50 hidden bg-stone-900 px-6 py-4 text-sm text-white"
>
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-3 sm:flex-row sm:justify-between">
		<p>
			Vi bruger cookies for at forbedre din oplevelse.
			<a href="/privatlivspolitik" class="underline hover:text-accent">Læs vores privatlivspolitik</a>.
		</p>
		<button
			id="cookie-accept"
			type="button"
			class="shrink-0 rounded-full bg-accent px-5 py-2 font-medium text-stone-900"
		>
			OK, forstået
		</button>
	</div>
</div>

<script>
	const banner = document.getElementById("cookie-banner");
	const acceptButton = document.getElementById("cookie-accept");
	const storageKey = "cookie-consent";

	if (banner && !localStorage.getItem(storageKey)) {
		banner.classList.remove("hidden");
	}

	acceptButton?.addEventListener("click", () => {
		localStorage.setItem(storageKey, "accepted");
		banner?.classList.add("hidden");
	});
</script>
