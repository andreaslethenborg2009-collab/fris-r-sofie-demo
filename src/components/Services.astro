---
import { site } from "../data/site.js";
---

<section id="services" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="font-heading text-3xl font-bold text-stone-900 md:text-4xl">Services</h2>
		<p class="mt-4 text-stone-600">Et udvalg tilpasset dig — fra hverdagsklip til den store forvandling.</p>
	</div>

	<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{site.services.map((service) => (
			<div class="rounded-2xl border border-stone-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
				<h3 class="font-heading text-xl font-semibold text-stone-900">{service.name}</h3>
				<p class="mt-3 text-sm leading-relaxed text-stone-600">{service.description}</p>
				<p class="mt-5 font-medium text-primary">Fra {service.priceFrom} kr.</p>
			</div>
		))}
	</div>
</section>
