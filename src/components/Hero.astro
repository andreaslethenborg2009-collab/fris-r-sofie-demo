---
import { Image } from "astro:assets";
import { site } from "../data/site.js";
import heroImage from "../assets/images/hero.jpg";
---

<section class="relative overflow-hidden bg-stone-50">
	<div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28">
		<div>
			<h1 class="font-heading text-4xl font-bold leading-tight text-stone-900 md:text-5xl">
				{site.business.tagline}
			</h1>
			<p class="mt-6 max-w-md text-lg text-stone-600">
				Hos {site.business.name} får du en personlig oplevelse i afslappede rammer midt i Aarhus —
				book din tid i dag.
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a
					href="#kontakt"
					class="rounded-full bg-primary px-8 py-3.5 font-medium text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90"
				>
					Book nu
				</a>
				<a
					href={`tel:${site.business.phone.replace(/\s/g, "")}`}
					class="rounded-full border border-stone-300 px-8 py-3.5 font-medium text-stone-700 transition-colors hover:border-primary hover:text-primary"
				>
					Ring nu
				</a>
			</div>
		</div>

		<div class="relative">
			<Image
				src={heroImage}
				alt={`Frisør styler kundes hår hos ${site.business.name}`}
				width={1000}
				height={1000}
				loading="eager"
				fetchpriority="high"
				class="aspect-square w-full rounded-3xl object-cover shadow-xl"
			/>
		</div>
	</div>
</section>
