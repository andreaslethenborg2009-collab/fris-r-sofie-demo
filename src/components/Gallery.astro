---
import { Image } from "astro:assets";
import { site } from "../data/site.js";

const images = [
	{ src: "/images/gallery-1.jpg", alt: `Produkter i salonen hos ${site.business.name}` },
	{ src: "/images/gallery-2.jpg", alt: `Indretning i salonen hos ${site.business.name}` },
	{ src: "/images/gallery-3.jpg", alt: `Interiør i salonen hos ${site.business.name}` },
	{ src: "/images/gallery-4.jpg", alt: `Klipning hos ${site.business.name}` },
];
---

<section id="galleri" class="bg-stone-50 py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-heading text-3xl font-bold text-stone-900 md:text-4xl">Galleri</h2>
			<p class="mt-4 text-stone-600">Et kig ind i salonen og noget af vores arbejde.</p>
		</div>

		<div class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-4">
			{images.map((image) => (
				<Image
					src={image.src}
					alt={image.alt}
					width={600}
					height={600}
					class="aspect-square w-full rounded-xl object-cover shadow-sm transition-transform hover:scale-[1.02]"
				/>
			))}
		</div>
	</div>
</section>
